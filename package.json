{
  "name": "affinity",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:jobs",
    "build:jobs": "esbuild scripts/bootstrap.ts sim/crowd-sim.ts scripts/retention.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist --out-extension:.js=.cjs --tsconfig=tsconfig.json",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "import-schedule": "tsx scripts/import-schedule.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "sim": "tsx sim/crowd-sim.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "next": "^16.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
